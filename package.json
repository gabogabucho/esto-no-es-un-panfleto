{
  "name": "esto-no-es-un-panfleto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Juego narrativo de decisiones sobre la resistencia estudiantil venezolana de 2014. Esqueleto jugable (cambio #1).",
  "scripts": {
    "dev": "npm run generate:pwa-assets && vite",
    "build": "npm run generate:pwa-assets && vite build",
    "preview": "vite preview",
    "test": "npm run check:locale && npm run check:attribution && npm run validate:content && vitest run",
    "test:unit": "vitest run",
    "check": "npm run check:locale && npm run check:attribution && npm run validate:content && vitest run",
    "check:locale": "node scripts/check-locale.mjs",
    "check:locale:register": "node scripts/check-locale.mjs --require-register",
    "check:attribution": "node scripts/check-attribution.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:content": "npm run validate:content",
    "generate:pwa-assets": "node scripts/generate-pwa-assets.mjs"
  },
  "devDependencies": {
    "@fontsource/anton": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/oswald": "^5.2.5",
    "ajv": "^8.17.1",
    "axe-core": "^4.10.2",
    "jsdom": "^26.1.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
